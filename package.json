{
  "name": "flowtrace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\" \"pnpm run dev:mock\"",
    "dev:server": "cmd /C \"set NODE_TLS_REJECT_UNAUTHORIZED=0&& tsx watch server/index.ts\"",
    "dev:client": "vite client",
    "dev:mock": "cmd /C \"set NODE_TLS_REJECT_UNAUTHORIZED=0&& tsx watch mock-forms-api/index.ts\"",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build client",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "cmd /C \"set NODE_TLS_REJECT_UNAUTHORIZED=0&& vitest run --fileParallelism=false --maxWorkers=1\"",
    "test:watch": "cmd /C \"set NODE_TLS_REJECT_UNAUTHORIZED=0&& vitest --fileParallelism=false --maxWorkers=1\"",
    "seed": "cmd /C \"set NODE_TLS_REJECT_UNAUTHORIZED=0&& tsx seed/runSeeds.ts\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "express": "^4.19.2",
    "mongodb": "^6.8.0",
    "zod": "^3.23.8",
    "dagre": "^0.8.5",
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/dagre": "^0.7.52",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.16.2",
    "vitest": "^1.6.0"
  }
}
